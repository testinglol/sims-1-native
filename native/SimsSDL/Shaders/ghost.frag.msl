#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct main0_out
{
    float4 color [[color(0)]];
};

struct main0_in
{
    float2 inUV [[user(locn0)]];
    float inOpacity [[user(locn3), flat]];
};

fragment main0_out main0(main0_in in [[stage_in]], texture2d<float> art [[texture(0)]], sampler artSmplr [[sampler(0)]])
{
    main0_out out = {};
    float4 sampled = art.sample(artSmplr, in.inUV);
    out.color = sampled * in.inOpacity;
    return out;
}
